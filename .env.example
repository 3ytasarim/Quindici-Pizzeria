# ─── Replit Object Storage (auto-provisioned via Replit App Storage) ────────────
# Created automatically when you run setupObjectStorage() in the Replit environment.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=replit-objstore-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket-name/public
PRIVATE_OBJECT_DIR=/your-bucket-name/private

# ─── Session / JWT signing key ──────────────────────────────────────────────────
# Used to sign admin JWT tokens. Use a long random string in production.
SESSION_SECRET=your-random-secret-here

# ─── Admin panel credentials ────────────────────────────────────────────────────
# Set via Replit Secrets — never commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-going-live

# ─── Instagram integration ──────────────────────────────────────────────────────
# INSTAGRAM_APP_ID is already set in .replit [userenv.shared].
# Obtain APP_SECRET and ACCESS_TOKEN from Meta Developer Console.
INSTAGRAM_APP_ID=your-meta-app-id
INSTAGRAM_APP_SECRET=your-meta-app-secret
INSTAGRAM_ACCESS_TOKEN=your-long-lived-instagram-access-token

# ─── Logging (optional) ─────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal  (default: info)
LOG_LEVEL=info
